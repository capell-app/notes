{
    "manifest-version": 3,
    "name": "capell-app/notes",
    "slug": "notes",
    "displayName": "Notes",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.x-dev",
    "description": "Add private, assignable notes and @mentions to any Capell admin record so editors can leave context, hand off work, and never lose track of what needs attention.",
    "product": {
        "group": "Capell Collaboration",
        "tier": "premium",
        "bundle": "collaboration"
    },
    "namespace": "Capell\\Notes",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": ["capell-app/admin"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Notes\\Providers\\NotesServiceProvider"],
        "admin": ["Capell\\Notes\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\Notes\\Manifest\\NotesAdminPageContribution",
            "pageClass": "Capell\\Notes\\Filament\\Pages\\NotesInboxPage",
            "userMenuKey": "capell-notes.inbox"
        },
        {
            "type": "admin-action-extender",
            "class": "Capell\\Notes\\Manifest\\NotesAdminActionExtenderContribution",
            "extenderClass": "Capell\\Notes\\Filament\\Extenders\\Page\\CreateNoteResourceHeaderActionExtender",
            "tag": "capell-admin:resource-header-actions"
        },
        {
            "type": "model",
            "class": "Capell\\Notes\\Manifest\\NotesModelsContribution",
            "modelClasses": [
                "Capell\\Notes\\Models\\Note",
                "Capell\\Notes\\Models\\NoteAssignment",
                "Capell\\Notes\\Models\\NoteMention",
                "Capell\\Notes\\Models\\NoteReminder"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Notes\\Manifest\\NotesReminderScheduleContribution",
            "name": "capell-notes-send-due-reminders",
            "command": "capell:notes:send-due-reminders",
            "frequency": "everyFiveMinutes"
        },
        {
            "type": "console-command",
            "class": "Capell\\Notes\\Manifest\\NotesConsoleCommandsContribution",
            "commands": [
                "capell:notes-demo",
                "capell:notes:send-due-reminders"
            ],
            "commandClasses": [
                "Capell\\Notes\\Console\\DemoCommand",
                "Capell\\Notes\\Console\\SendDueNoteRemindersCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\Notes\\Manifest\\NotesHealthContribution",
            "checkClass": "Capell\\Notes\\Health\\NotesHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "notes",
            "note_assignments",
            "note_mentions",
            "note_reminders"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:notes-demo",
        "demoParams": ["force", "allow-production"],
        "doctor": null,
        "sendDueReminders": "capell:notes:send-due-reminders"
    },
    "settings": [],
    "permissions": [
        "View:Note",
        "Resolve:Note",
        "Reopen:Note",
        "CompleteAssignment:Note"
    ],
    "capabilities": ["notes", "notes-admin"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": ["notes.body"],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": [
                "Queued attention notifications contain only an opaque note identifier and notification type."
            ]
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:Note",
                "Resolve:Note",
                "Reopen:Note",
                "CompleteAssignment:Note"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "notes.package-health",
            "label": "Notes storage tables and model morph aliases are present and registered.",
            "class": "Capell\\Notes\\Health\\NotesHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Add private, assignable notes and @mentions to any Capell admin record so editors can leave context, hand off work, and never lose track of what needs attention.",
        "description": "Notes turns Capell admin records into a collaboration surface: leave a contextual note on a page (or any opted-in record), assign it to teammates, and mention people who need to weigh in. A per-user inbox and user-menu badge surface what's assigned to you and where you've been mentioned, so nothing slips between editors. Notes are strictly admin-internal with per-note visibility (record-editors or private) and are never exposed on the public site. Built the Capell way — domain logic in Actions, polymorphic attachment to any registered subject — so it extends cleanly into your own resources.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Notes extension preview image",
                "caption": "Notes extension preview"
            },
            {
                "path": "docs/screenshots/notes-inbox-page.png",
                "alt": "Notes inbox with assigned notes, mentions, and lifecycle controls",
                "caption": "Review assigned notes, mentions, reminders, and open lifecycle actions from the Capell admin inbox."
            },
            {
                "path": "docs/screenshots/notes-user-menu-badge.png",
                "alt": "Opened Capell admin user menu showing the Notes attention badge",
                "caption": "Editors see assigned notes, unread mentions, and overdue reminders from the Capell admin user menu."
            },
            {
                "path": "docs/screenshots/notes-record-add-note-modal.png",
                "alt": "Record-level Add note modal on a Capell page edit screen",
                "caption": "Leave contextual record-level notes with visibility, assignment, mention, and reminder fields from the page edit workflow."
            },
            {
                "path": "docs/screenshots/notes-empty-inbox.png",
                "alt": "Empty Notes inbox state",
                "caption": "A quiet empty state keeps the Notes inbox clear when no collaboration items need attention."
            }
        ],
        "categories": ["admin", "collaboration"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
